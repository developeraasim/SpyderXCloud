# Copy to .env for local API development. Never add real secrets to this tracked example.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# Firebase browser configuration is public (it is included in client JavaScript).
# Protect the Firebase project with Auth settings, API-key restrictions, and Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Firebase Admin service-account JSON is private. Configure only in API runtime secrets.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=
# Alternatively, keep the downloaded JSON under the Git-ignored secrets/ folder and set its path.
FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=
FIREBASE_APP_CHECK_ENFORCED=false

# Server-only test checkout and fulfillment secrets. Never use VITE_ for these.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
DISCORD_ORDER_WEBHOOK_URL=

